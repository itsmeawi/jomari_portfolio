# ==============================================================================
# Google Sheets CMS Database Configuration (Google Sheets API v4)
# ==============================================================================

# The ID of your Google Sheet (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Service Account Client Email generated from Google Cloud Console (IAM & Admin -> Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# Service Account RSA Private Key (keep full "-----BEGIN PRIVATE KEY-----\n..." or replace with env formatted key)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...YOUR_KEY...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# Application URL / Site Metadata
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://jomari.dev
